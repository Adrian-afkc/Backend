# Copia este archivo como .env y ajusta los valores de tu máquina.
#
# Autenticación de Windows (por defecto): deja DB_TRUSTED_CONNECTION=yes
# y no llenes DB_USER / DB_PASSWORD. SQL Server valida con el usuario de
# Windows que ejecuta el backend.
#
# Para una instancia con nombre usa DB_SERVER=localhost\SQLEXPRESS
# o DB_SERVER=localhost,1433 si el puerto no es el dinámico.

DB_DRIVER=ODBC Driver 18 for SQL Server
DB_SERVER=localhost
DB_DATABASE=OllaComunSector10
DB_TRUSTED_CONNECTION=yes
DB_ENCRYPT=yes
DB_TRUST_SERVER_CERTIFICATE=yes
DB_TIMEOUT=15

# Solo para autenticación SQL (DB_TRUSTED_CONNECTION=no).
# DB_USER=sa
# DB_PASSWORD=tu_contrasena
